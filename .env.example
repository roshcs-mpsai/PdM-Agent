# Copy to .env (git-ignored) and set real values; docker compose reads .env.
PG_PASSWORD=change-me

# Services and tools outside Docker find the store here; inside compose the
# services get postgresql://pdm:${PG_PASSWORD}@postgres:5432/pdm.
# Without it they use sqlite:///runs/pdm.db.
# PDM_STORE=postgresql://pdm:change-me@localhost:5432/pdm

# MQTT broker (R3, docs/SECURITY.md). Unset: the R0 development broker on localhost:1883, no login.
# PDM_MQTT_HOST=localhost
# PDM_MQTT_PORT=8883
# PDM_MQTT_TLS_CA=mosquitto/certs/ca.crt
# python tools/broker_users.py appends PDM_MQTT_USER_<SERVICE> and PDM_MQTT_PASSWORD_<SERVICE> for every account.
# HTTP API and connector tokens, one per role: python -c "import secrets; print(secrets.token_urlsafe(32))"
# PDM_TOKEN_REVIEWER=
# PDM_TOKEN_ENGINEER=
# PDM_TOKEN_OPERATOR=
# PDM_TOKEN_AGENT=
# PDM_TOKEN_CONNECTOR=

# Work-order endpoint for services/connector (the simulator in the demo stack).
# The connector presents PDM_WORKORDER_TOKEN, or PDM_TOKEN_CONNECTOR when that is unset.
# PDM_WORKORDER_URL=http://localhost:8088/api/work-orders
# PDM_WORKORDER_TOKEN=

# The agent (services/agent). Without a key it can only replay a script (--scripted).
# ANTHROPIC_API_KEY=
# In the stack the agent writes through the API and reaches the tools over MCP:
# PDM_API_URL=http://api:8000
# PDM_MCP_URL=http://mcp_server:8765/mcp
