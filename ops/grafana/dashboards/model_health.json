    {
      "id": 6,
      "type": "timeseries",
      "title": "Windows per minute: scored, dropped, refused",
      "description": "Scored by the detector; dropped by ingest (incomplete: a gap, a freeze, persistent bad values); refused by the detector (features computed differently from the freeze, bad payloads).",
      "datasource": {
        "type": "prometheus",
        "uid": "pdm-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pdm-prometheus"
          },
          "expr": "sum by (asset) (rate(pdm_windows_scored_total{asset=~\"$asset\"}[$__rate_interval])) * 60",
          "legendFormat": "scored {{asset}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "pdm-prometheus"
          },
          "expr": "sum by (asset) (rate(pdm_windows_dropped_total{asset=~\"$asset\"}[$__rate_interval])) * 60",
          "legendFormat": "dropped {{asset}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "pdm-prometheus"
          },
          "expr": "sum by (asset, reason) (rate(pdm_windows_refused_total{asset=~\"$asset\"}[$__rate_interval])) * 60",
          "legendFormat": "refused {{asset}} {{reason}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
