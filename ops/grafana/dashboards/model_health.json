  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Model health**: what the detector, gate, prognostics, drift check and agent decide. NFR-01 check for a 10x replay: *p95 scoring latency over the range* stays under 2 s. Service up/down and message rates are on **PdM-Agent service health**. An incident's trace: Jaeger, service `agent`, tag `incident_id=<id>` (`ops/README.md`).",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 scoring latency over the range",
      "description": "95th percentile of pdm_scoring_seconds over the whole selected range: the NFR-01 figure (target under 2 s).",
      "datasource": {
        "type": "prometheus",
        "uid": "pdm-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pdm-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(pdm_scoring_seconds_bucket{asset=~\"$asset\"}[$__range])))",
          "legendFormat": "p95",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "mappings": [],
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Windows scored within 2 s",
      "description": "Share of scored windows whose scoring took 2 s or less (the 2.0 bucket over the count), over the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "pdm-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pdm-prometheus"
          },
          "expr": "sum(increase(pdm_scoring_seconds_bucket{asset=~\"$asset\", le=\"2.0\"}[$__range])) / sum(increase(pdm_scoring_seconds_count{asset=~\"$asset\"}[$__range]))",
          "legendFormat": "within 2 s",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
