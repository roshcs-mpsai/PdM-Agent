      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pdm-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (job, topic, le) (rate(pdm_handler_seconds_bucket{job=~\"$job\"}[5m])))",
          "legendFormat": "{{job}} {{topic}}",
          "editorMode": "code",
          "range": true,
          "instant": false
