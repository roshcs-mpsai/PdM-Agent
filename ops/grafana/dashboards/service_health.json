    {
      "id": 7,
      "type": "timeseries",
      "title": "Handler p95 latency, by topic",
      "description": "95th percentile of pdm_handler_seconds over 5 minutes: time inside the service per message. The red line is 2 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "pdm-prometheus"
